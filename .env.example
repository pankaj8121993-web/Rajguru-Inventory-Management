# Local development database.
# Never commit a real .env — see docs/04-security/SECURITY_MODEL.md.
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/rajguru_dev

# Development actor used for created_by / audit attribution until Supabase Auth
# is provisioned. See docs/08-releases/KNOWN_ISSUES.md.
DEV_ACTOR_CODE=EMP001

# When Supabase is provisioned these replace DATABASE_URL:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only — never NEXT_PUBLIC_ (INV-25)
